{
	"info": {
		"_postman_id": "focustask-api-collection-v1",
		"name": "FocusTask REST API",
		"description": "Complete CRUD, Validation, and Exception Handling collection for FocusTask Spring Boot API.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081/api/tasks",
			"type": "string"
		},
		{
			"key": "taskId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Create Task (Valid Input - 201 Created)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"Response returns valid Task with ID\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.be.a('number');",
							"    pm.collectionVariables.set(\"taskId\", jsonData.id);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Learn Spring Boot Postman Testing\",\n    \"description\": \"Test all 5 CRUD operations, validation and error flows\",\n    \"completed\": false\n}"
				},
				"url": {
					"raw": "{{baseUrl}}",
					"host": [
						"{{baseUrl}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Create Task (Invalid Input - Empty Title - 400 Bad Request)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400 Bad Request\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"pm.test(\"Error message indicates title is mandatory\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.errors.title).to.eql(\"Title is mandatory\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"\",\n    \"description\": \"Missing title should fail validation\",\n    \"completed\": false\n}"
				},
				"url": {
					"raw": "{{baseUrl}}",
					"host": [
						"{{baseUrl}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Get All Tasks (200 OK)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response is an array of tasks\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}",
					"host": [
						"{{baseUrl}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Get Task By ID (200 OK)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Returns correct task id\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.eql(parseInt(pm.collectionVariables.get(\"taskId\")));",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/{{taskId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"{{taskId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "5. Get Nonexistent Task (404 Not Found)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 404 Not Found\", function () {",
							"    pm.response.to.have.status(404);",
							"});",
							"pm.test(\"Error response contains 404 status and message\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(404);",
							"    pm.expect(jsonData.message).to.include(\"Task not found\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/9999",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"9999"
					]
				}
			},
			"response": []
		},
		{
			"name": "6. Update Task (200 OK)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Completed field updated to true\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.completed).to.eql(true);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Learn Spring Boot Postman Testing (Completed)\",\n    \"description\": \"All CRUD endpoints tested and verified with Postman\",\n    \"completed\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/{{taskId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"{{taskId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "7. Delete Task (204 No Content)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 204 No Content\", function () {",
							"    pm.response.to.have.status(204);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/{{taskId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"{{taskId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "8. Delete Nonexistent Task (404 Not Found)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 404 Not Found\", function () {",
							"    pm.response.to.have.status(404);",
							"});",
							"pm.test(\"Error response contains 404 status and message\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(404);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/9999",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"9999"
					]
				}
			},
			"response": []
		}
	]
}
